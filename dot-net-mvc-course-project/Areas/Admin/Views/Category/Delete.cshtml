@model Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Delete Category</h5>
        </div>

        <div class="card-body">
            <form method="post">
                <div class="row mb-3">
                    <div class="col-md-6">
                        @* <label class="form-label">Category Name</label> *@
                         <label asp-for="Name" class="form-label"></label>
                        <input disabled asp-for="Name" type="text"
                               class="form-control"
                               placeholder="Enter category name">
                    </div>

                    <div class="col-md-6">
                        @* <label class="form-label">Display Order</label> *@
                        <label asp-for="DisplayOrder" class="form-label"></label>
                        <input disabled asp-for="DisplayOrder" type="number"
                               class="form-control"
                               placeholder="Enter display order">
                    </div>
                </div>


                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="Category" asp-action="Index" type="button" class="btn btn-secondary">
                        Go Back
                    </a>

                    <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="16" height="16" fill="currentColor"
                             class="bi bi-plus-square-fill" viewBox="0 0 16 16">
                            <path d="M2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2zm6.5 4.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3a.5.5 0 0 1 1 0"/>
                        </svg>
                        Delete Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

